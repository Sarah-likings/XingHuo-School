# ============================================================
# 星火校园 · 环境变量样例
# 复制为 .env 后填入本地值；.env 不得入库（见 .gitignore）
# ============================================================

# ---- 应用 ----
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ---- 鉴权（JWT 存 httpOnly Cookie）----
JWT_SECRET=xinghuo-dev-secret-change-me-in-production-32b
JWT_EXPIRE_MINUTES=1440

# ---- PostgreSQL ----
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=xinghuo
POSTGRES_USER=xinghuo
POSTGRES_PASSWORD=please-change-this-in-dev

# ---- Redis ----
REDIS_URL=redis://cache:6379/0

# ---- 对象存储（S3 兼容：MinIO 或云厂商）----
S3_ENDPOINT=http://storage:9000
S3_REGION=us-east-1
S3_BUCKET=xinghuo-private
S3_ACCESS_KEY=please-change-this-in-dev
S3_SECRET_KEY=please-change-this-in-dev
S3_SIGN_EXPIRE_SECONDS=300

# ---- 邮件通知（软依赖，失败降级为站内通知）----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- 业务时限与开关（配置项，禁止写死在代码里）----
ORDER_ACCEPT_TIMEOUT_HOURS=48    # 交付后超时自动完成
APPEAL_DECIDE_TIMEOUT_HOURS=72   # 仲裁时限
TASK_APPLY_LIMIT=5               # 单任务申请人数上限
TASK_REWARD_MAX=500              # 单笔悬赏上限（元）
FEATURE_AI_DRAFT=true            # 发布侧一句话生成草稿
FEATURE_AI_LLM=false             # 大模型接入（需自备额度）
FEATURE_MAINTENANCE=false        # 维护模式：全站只读提示页
READONLY_MODE=false              # 对账异常时由系统置为 true

# ---- 限流与备份 ----
RATE_LIMIT_PER_MINUTE=60
BACKUP_KEEP_DAYS=7
